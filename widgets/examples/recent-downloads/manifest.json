{
  "api": 1,
  "id": "com.example.recent-downloads",
  "name": "Downloads",
  "version": "1.1.0",
  "description": "Newest items in ~/Downloads; click to reveal, insert the path, or open.",
  "author": "GRID examples",
  "entry": "widget.js",
  "refresh": 15,
  "events": [],
  "settings": [
    { "key": "count", "type": "number", "label": "Items", "default": 6, "min": 3, "max": 20 },
    { "key": "hidePartial", "type": "bool", "label": "Skip partial downloads", "default": true },
    { "key": "rowClick", "type": "choice", "label": "Row click", "default": "reveal", "options": ["reveal", "insert", "open"] }
  ],
  "permissions": {
    "fs.read": ["~/Downloads/**"],
    "terminal.insertPath": true,
    "clipboard.write": true
  }
}
